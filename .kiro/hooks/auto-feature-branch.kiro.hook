{
  "enabled": true,
  "name": "Auto Feature Branch Creator",
  "description": "Detects when a new feature folder is created in .kiro/specs (specifically when a requirements file is created) and automatically creates and switches to a new feature branch based on the spec name, but only when on the main branch",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/specs/**/requirements.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new feature spec has been detected in .kiro/specs. Check if the current git branch is 'main'. If it is, extract the feature name from the spec folder path (the folder name containing the requirements.md file), create a new git branch with that name (e.g., 'feature/spec-folder-name'), and switch to it. If not on main, do nothing. Provide confirmation of the branch creation or explain why no action was taken."
  }
}