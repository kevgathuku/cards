#!/bin/sh
#
# Pre-commit hook to run mix format on staged Elixir and Phoenix files
# Preserves partially staged files by stashing unstaged changes
#

# Get all staged .ex, .exs, and .heex files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs|heex)$')

if [ -z "$STAGED_FILES" ]; then
  # No Elixir/Phoenix files staged, exit successfully
  exit 0
fi

echo "Running mix format on staged files..."

# Stash unstaged changes (including untracked files)
git stash push --keep-index --include-untracked --quiet

# Run mix format on staged files
echo "$STAGED_FILES" | xargs mix format

# Re-add the formatted files to staging
echo "$STAGED_FILES" | xargs git add

# Restore unstaged changes
git stash pop --quiet

echo "✓ Code formatting applied to staged changes only"
exit 0
