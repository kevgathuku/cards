#!/bin/sh
#
# Pre-commit hook to run mix format on staged Elixir and Phoenix files
#

# Get all staged .ex, .exs, and .heex files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs|heex)$')

if [ -z "$STAGED_FILES" ]; then
  # No Elixir/Phoenix files staged, exit successfully
  exit 0
fi

echo "Running mix format on staged files..."

# Run mix format on staged files
echo "$STAGED_FILES" | xargs mix format

# Check if formatting made any changes
FORMATTING_CHANGES=$(git diff --name-only $STAGED_FILES)

if [ -n "$FORMATTING_CHANGES" ]; then
  echo ""
  echo "Code formatting applied. Please review the changes and re-stage:"
  echo "$FORMATTING_CHANGES" | sed 's/^/  /'
  echo ""
  echo "Run: git add <files> && git commit"
  exit 1
fi

echo "✓ Code formatting check passed"
exit 0
