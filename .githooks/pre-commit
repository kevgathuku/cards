#!/bin/sh
#
# Pre-commit hook to run mix format on staged Elixir and Phoenix files
# Formats files in place and re-stages them
#

# Get all staged .ex, .exs, and .heex files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs|heex)$')

if [ -z "$STAGED_FILES" ]; then
  # No Elixir/Phoenix files staged, exit successfully
  exit 0
fi

echo "Running mix format on staged files..."

# Run mix format on staged files (formats in place)
echo "$STAGED_FILES" | xargs mix format

# Check if formatting changed any files by comparing working tree to index
CHANGED_FILES=""
for file in $STAGED_FILES; do
  if ! git diff --quiet -- "$file"; then
    CHANGED_FILES="$CHANGED_FILES $file"
  fi
done

if [ -n "$CHANGED_FILES" ]; then
  echo "✓ Files were formatted. Re-staging changes..."
  # Re-add the formatted files to staging
  echo "$CHANGED_FILES" | xargs git add
  echo ""
  echo "Note: Files were auto-formatted. Review changes with 'git diff --cached'"
else
  echo "✓ All files already formatted correctly"
fi

exit 0
