#!/bin/sh
#
# Pre-commit hook to check if staged Elixir and Phoenix files are formatted
# Does NOT auto-format or stage changes - only reports conflicts
#

# Get all staged .ex, .exs, and .heex files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ex|exs|heex)$')

if [ -z "$STAGED_FILES" ]; then
  # No Elixir/Phoenix files staged, exit successfully
  exit 0
fi

echo "Checking format on staged files..."

# Run mix format --check-formatted on staged files
# This checks without modifying files
if echo "$STAGED_FILES" | xargs mix format --check-formatted 2>&1; then
  echo "✓ All files are properly formatted"
  exit 0
else
  echo ""
  echo "❌ Formatting conflicts detected!"
  echo ""
  echo "The following files need formatting:"
  echo "$STAGED_FILES" | xargs mix format --check-formatted 2>&1 | grep "\.ex"
  echo ""
  echo "To fix, run:"
  echo "  mix format"
  echo ""
  echo "Then stage and commit your changes again."
  exit 1
fi
