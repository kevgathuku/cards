<.header>
  <p>Game session {"#{@game_session.id} - #{@game_session.short_code}"}</p>
  <p>Created By: {@game_session.created_by.email}</p>
  <p>Status: {@game_session.status}</p>
  <p>Current Player: {@current_player.email}</p>
</.header>

<%= if @game_session.status == "lobby" and @current_player.id == @game_session.created_by_id do %>
  <.button phx-click="start_game">Start Game</.button>
<% end %>

<%= if @game_session.status == "live" do %>
  <%= if @current_turn_player do %>
    <div class="mt-4 p-4 bg-blue-100 border border-blue-300 rounded-lg text-center">
      <p class="text-lg font-semibold">
        Current Turn: <span class="text-blue-700">{@current_turn_player.email}</span>
      </p>
      <%= if @current_turn_player.id == @current_player.id do %>
        <p class="text-sm text-blue-600 mt-1">It's your turn!</p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 p-4 border rounded-lg">
    <h2 class="text-xl font-bold mb-4">Game Board</h2>
    <div class="flex space-x-8">
      
<!-- Played Pile -->
      <div class="w-1/2">
        <h3 class="text-lg font-semibold">Played Pile</h3>
        <div class="mt-2 p-4 border-dashed border-2 border-gray-300 rounded-lg h-32 flex items-center justify-center">
          <%= if top_card = List.last(@played_pile) do %>
            <span>{top_card.card.rank} of {top_card.card.suit}</span>
          <% else %>
            <span class="text-gray-500">Empty</span>
          <% end %>
        </div>
      </div>
      
<!-- Deck -->
      <div class="w-1/2">
        <h3 class="text-lg font-semibold">Deck</h3>
        <div class="mt-2 p-4 border-dashed border-2 border-gray-300 rounded-lg h-32 flex items-center justify-center">
          <span class="text-gray-700">~{@deck_size} cards left</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 p-4 border rounded-lg">
    <h2 class="text-xl font-bold mb-4">Your Hand</h2>
    <div class="flex space-x-4">
      <%= for dc <- @player_hand do %>
        <div class="p-4 border rounded-md shadow-sm bg-white">
          {dc.card.rank} of {dc.card.suit}
        </div>
      <% end %>
    </div>
  </div>

  <div id="other-players" class="mt-8 p-4 border rounded-lg">
    <h2 class="text-xl font-bold mb-4">Other Players</h2>
    <div class="flex space-x-4">
      <%= for player <- @other_players_hands do %>
        <div class="p-4 border rounded-md shadow-sm bg-gray-200">
          <p class="font-semibold">{player.email}</p>
          <p>{player.hand_size} cards</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
