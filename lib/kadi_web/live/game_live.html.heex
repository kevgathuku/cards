<.header>
  <p>Game session {"#{@game_session.id} - #{@game_session.short_code}"}</p>
  <p>Created By: {@game_session.created_by.email}</p>
  <p>Status: {@game_session.status}</p>
  <p>Current Player: {@current_player.email}</p>
</.header>

<%= if @game_session.status == "lobby" and @current_player.id == @game_session.created_by_id do %>
  <.button phx-click="start_game">Start Game</.button>
<% end %>

<%= if @game_session.status == "live" do %>
  <%= if @current_turn_player do %>
    <div class="mt-4 p-4 bg-blue-100 border border-blue-300 rounded-lg text-center">
      <p class="text-lg font-semibold">
        Current Turn: <span class="text-blue-700">{@current_turn_player.email}</span>
      </p>
      <%= if @current_turn_player.id == @current_player.id do %>
        <p class="text-sm text-blue-600 mt-1">It's your turn!</p>

        <%!-- T039: Conditional penalty acceptance button (FR-004, FR-005) --%>
        <%= if show_penalty_button?(@game_session, @current_player.id) do %>
          <.button
            phx-click="accept_penalty"
            phx-disable-with="Drawing penalty cards..."
            class="mt-2 btn-penalty bg-red-600 hover:bg-red-700"
          >
            Draw {@game_session.draw_penalty["count"]} Cards
          </.button>
        <% else %>
          <%!-- Draw Card Button - Visible when deck has cards OR played pile can be recycled --%>
          <%= if @deck_size > 0 or length(@played_pile) >= 2 do %>
            <.button phx-click="draw_card" phx-disable-with="Drawing..." class="mt-2">
              <%= if @deck_size == 0 do %>
                Draw Card (Recycle Pile)
              <% else %>
                Draw Card
              <% end %>
            </.button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= if @game_session.action_type == "select_suit" and @current_turn_player.id == @current_player.id do %>
    <div class="mt-4 p-4 bg-yellow-100 border border-yellow-300 rounded-lg text-center">
      <p class="text-lg font-semibold text-yellow-800">Select a suit:</p>
      <div class="mt-2 flex justify-center space-x-2">
        <.button
          phx-click="select_suit"
          phx-value-suit="hearts"
          class="bg-red-500 hover:bg-red-600"
        >
          ♥ Hearts
        </.button>
        <.button
          phx-click="select_suit"
          phx-value-suit="diamonds"
          class="bg-red-500 hover:bg-red-600"
        >
          ♦ Diamonds
        </.button>
        <.button
          phx-click="select_suit"
          phx-value-suit="clubs"
          class="bg-gray-800 hover:bg-gray-900"
        >
          ♣ Clubs
        </.button>
        <.button
          phx-click="select_suit"
          phx-value-suit="spades"
          class="bg-gray-800 hover:bg-gray-900"
        >
          ♠ Spades
        </.button>
      </div>
    </div>
  <% end %>

  <%!-- T061: Display active suit requirement --%>
  <%= if @game_session.action_suit do %>
    <div class="mt-4 p-4 bg-purple-100 border border-purple-300 rounded-lg text-center">
      <p class="text-lg font-semibold text-purple-800">
        Required Suit:
        <span class="text-2xl">
          {suit_symbol(@game_session.action_suit)} {String.capitalize(@game_session.action_suit)}
        </span>
      </p>
      <p class="text-sm text-purple-600 mt-1">
        You must play a card of this suit (or an Ace)
      </p>
    </div>
  <% end %>

  <%!-- T038: Direction Indicator --%>
  <div
    class="mt-4 p-3 bg-gray-50 border border-gray-300 rounded-lg flex items-center justify-center gap-2"
    role="status"
    aria-live="polite"
  >
    <.icon name={direction_icon(@direction)} class="w-5 h-5 text-gray-700" />
    <span class="font-medium text-gray-900">
      Turn Order: {direction_label(@direction)}
    </span>
  </div>

  <%!-- T027: Persistent Draw Penalty Indicator (FR-012) --%>
  <%!-- T040: Hide indicator when animation is playing (FR-008) --%>
  <%= if @game_session.draw_penalty && @game_session.draw_penalty["active"] == true && !@show_penalty_animation do %>
    <% target_player_id = @game_session.draw_penalty["target_player_id"] %>
    <% penalty_count = @game_session.draw_penalty["count"] %>
    <% target_player =
      if target_player_id == @current_player.id do
        "You"
      else
        player =
          Enum.find(@other_players_hands, fn p -> p.id == target_player_id end)

        if player, do: player.email, else: "Next player"
      end %>
    <div
      class="penalty-indicator mt-4 p-4 bg-red-50 border-2 border-red-400 rounded-lg shadow-lg"
      role="alert"
      aria-live="assertive"
    >
      <div class="flex items-center justify-center gap-3">
        <.icon name="hero-exclamation-triangle" class="w-6 h-6 text-red-600" />
        <div class="text-center">
          <p class="text-lg font-bold text-red-800">
            Draw {penalty_count} Penalty Active
          </p>
          <p class="text-sm text-red-700 mt-1">
            {target_player} must draw {penalty_count} cards or block with an Ace/'2'
          </p>
        </div>
        <.icon name="hero-exclamation-triangle" class="w-6 h-6 text-red-600" />
      </div>
    </div>
  <% end %>

  <%!-- T057: Toast Notification System with FR-025 coalescing --%>
  <%= if @toast do %>
    <% toast_type = Map.get(@toast, :type, :info) %>
    <% {bg_class, border_class, text_class} =
      case toast_type do
        :penalty ->
          {"bg-red-50", "border-red-300", "text-red-800"}

        :warning ->
          {"bg-yellow-50", "border-yellow-300", "text-yellow-800"}

        _ ->
          if String.contains?(@toast.message, "recycle") or
               String.contains?(@toast.message, "exhausted") do
            {"bg-yellow-50", "border-yellow-300", "text-yellow-800"}
          else
            {"bg-blue-50", "border-blue-300", "text-blue-800"}
          end
      end %>
    <div
      class={"mt-4 p-3 rounded-lg border #{bg_class} #{border_class}"}
      role="status"
      aria-live="polite"
    >
      <p class={"text-sm font-medium #{text_class}"}>
        {@toast.message}
      </p>
    </div>
  <% end %>

  <div class="mt-8 p-4 border rounded-lg">
    <h2 class="text-xl font-bold mb-4">Game Board</h2>
    <div class="flex space-x-8">
      
<!-- Played Pile -->
      <div class="w-1/2">
        <h3 class="text-lg font-semibold">Played Pile</h3>
        <div class="mt-2 p-4 border-dashed border-2 border-gray-300 rounded-lg h-32 flex items-center justify-center">
          <%= if top_card = List.last(@played_pile) do %>
            <span>{top_card.card.rank} of {top_card.card.suit}</span>
          <% else %>
            <span class="text-gray-500">Empty</span>
          <% end %>
        </div>
      </div>
      
<!-- Deck -->
      <div class="w-1/2">
        <h3 class="text-lg font-semibold">Deck</h3>
        <div class="mt-2 p-4 border-dashed border-2 border-gray-300 rounded-lg h-32 flex items-center justify-center">
          <span class="text-gray-700">~{@deck_size} cards left</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 p-4 border rounded-lg">
    <div class="flex items-center gap-3 mb-4">
      <h2 class="text-xl font-bold">Your Hand</h2>
      <%!-- T058: Cardless player badge for current player --%>
      <%= if Map.get(@player_statuses, @current_player.id) == "cardless" do %>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800 border border-purple-300">
          Cardless
        </span>
      <% end %>
    </div>

    <%= if @current_turn_player && @current_turn_player.id == @current_player.id do %>
      <div class="mb-4">
        <.button
          phx-click="play_cards"
          phx-disable-with="Playing..."
          disabled={Enum.empty?(@selected_cards)}
          class="mr-2"
        >
          Play Selected Cards ({length(@selected_cards)})
        </.button>

        <%= if not Enum.empty?(@selected_cards) do %>
          <button
            phx-click={JS.push("toggle_card", value: %{card_id: "clear_all"})}
            class="text-sm text-gray-600 underline"
            type="button"
          >
            Clear Selection
          </button>
        <% end %>
      </div>
    <% end %>

    <div class="flex space-x-4 flex-wrap">
      <%= for dc <- @player_hand do %>
        <% is_selected = dc.card_id in @selected_cards %>
        <%!-- T062: Highlight cards matching required suit --%>
        <% matches_required_suit =
          @game_session.action_suit &&
            (dc.card.suit == @game_session.action_suit || dc.card.rank == "ace") %>
        <%!-- T043: Add animation class when penalty animation is active --%>
        <% animation_class = if @show_penalty_animation, do: "penalty-card-animation", else: "" %>
        <%!-- T045: Cards remain clickable when penalty button shown (FR-007 strategic choice) --%>
        <div
          class={
            "p-4 border rounded-md shadow-sm cursor-pointer transition-all #{card_class(is_selected, matches_required_suit)} #{animation_class}"
          }
          phx-click="toggle_card"
          phx-value-card_id={dc.card_id}
        >
          {dc.card.rank} of {dc.card.suit}
        </div>
      <% end %>
    </div>
  </div>

  <div id="other-players" class="mt-8 p-4 border rounded-lg">
    <h2 class="text-xl font-bold mb-4">Other Players</h2>
    <div class="flex space-x-4">
      <%= for player <- @other_players_hands do %>
        <div class="p-4 border rounded-md shadow-sm bg-gray-200">
          <div class="flex items-center gap-2">
            <p class="font-semibold">{player.email}</p>
            <%!-- T058: Cardless player badge --%>
            <%= if Map.get(@player_statuses, player.id) == "cardless" do %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-300">
                Cardless
              </span>
            <% end %>
          </div>
          <p>{player.hand_size} cards</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
