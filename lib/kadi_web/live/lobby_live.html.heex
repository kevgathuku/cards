<section class="phx-hero">
  <div class="mx-auto max-w-2xl sm:text-center">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Kadi</h2>
  </div>

  <div class="mx-auto max-w-xs px-8">
    <button
      class="mt-10 block w-full rounded-md bg-green-700 px-3 py-2 text-center text-sm font-semibold text-white focus-visible:outline border border-green-700 hover:bg-green-800 focus:ring-4"
      phx-click="create_game"
    >
      Create game
    </button>
  </div>
</section>

<div class="max-w-2xl mx-auto p-6 sm:text-center">
  <h1 class="text-2xl font-bold text-gray-800 my-6">Your In-Progress Games</h1>
  <%= if @games == [] do %>
    <p class="text-gray-600">No games in progress. Start a new game!</p>
  <% else %>
    <ul class="space-y-4">
      <li :for={game <- @games} class="border border-gray-200 rounded-md p-4 bg-white shadow-sm">
        <div class="flex justify-between items-center">
          <div>
            <h2 class="text-lg font-semibold text-gray-700">
              Game <%= game.short_code %>
            </h2>
            <p class="text-sm text-gray-500">
              Created by: <%= game.created_by.email %>
            </p>
            <p class="text-sm text-gray-500">
              Started: <%= game.inserted_at |> Calendar.strftime("%b %d, %Y %H:%M") %>
            </p>
            <p class="text-sm text-gray-500">
              Players: <%= game.player_count %>/4
            </p>
          </div>
          <.link
            navigate={~p"/games/#{game.id}"}
            class="mt-4 block w-40 rounded-md bg-teal-50 px-3 py-2 text-center text-sm font-semibold text-green-700 border border-green-700 hover:text-white hover:bg-green-700 focus:ring-4"
          >
            Join game
          </.link>
        </div>
      </li>
    </ul>
  <% end %>
</div>
