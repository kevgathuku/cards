<.simple_form
  for={@form}
  phx-change="validate"
  phx-submit="save"
  method="post"
  action={~p"/games"}
>
  <.input field={@form[:created_by]} label="Display Name" />
  <:actions>
    <.button class="mt-10 block w-full rounded-md bg-green-700 px-3 py-2 text-center text-sm font-semibold text-white focus-visible:outline border border-green-700 hover:bg-green-800 focus:ring-4">
      Create game
    </.button>
  </:actions>
</.simple_form>
