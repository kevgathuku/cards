{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; Web
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        metosin/reitit {:mvn/version "0.7.2"}

        ;; HTML templating
        hiccup/hiccup {:mvn/version "2.0.0-RC3"}

        ;; Session management
        ring/ring-session {:mvn/version "0.1.0"}

        ;; Security (token generation)
        crypto-random/crypto-random {:mvn/version "1.2.1"}

        ;; WebSockets
        com.taoensso/sente {:mvn/version "1.19.2"}

        ;; Database (SQLite)
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
        org.xerial/sqlite-jdbc {:mvn/version "3.45.1.0"}

        ;; JSON
        metosin/jsonista {:mvn/version "0.3.8"}

        ;; Validation
        metosin/malli {:mvn/version "0.16.1"}

        ;; Logging
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.6"}}

 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                     cider/cider-nrepl {:mvn/version "0.49.1"}}}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}

  :run {:main-opts ["-m" "kadi.core"]}

  :repl {:main-opts ["-m" "nrepl.cmdline"
                     "--middleware" "[cider.nrepl/cider-middleware]"]}}}
