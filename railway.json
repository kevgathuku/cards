{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "volumeMounts": [
      {
        "mountPath": "/app/data",
        "name": "kadi-data"
      }
    ]
  },
  "volumes": [
    {
      "name": "kadi-data",
      "size": "100MiB"
    }
  ]
}
